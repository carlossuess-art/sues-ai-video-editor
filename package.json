{
  "name": "sues-ai-video-editor-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "dry-run": "node src/cli.js prepare examples/plan.json --out runtime/demo",
    "poc": "node --env-file-if-exists=.env src/cli.js",
    "check": "node scripts/check.mjs",
    "reframe": "node scripts/vision/build_reframe.mjs",
    "template:calma": "node scripts/templates/prepare_cinematic.mjs",
    "preview:prepare": "node scripts/templates/prepare_local_preview.mjs",
    "preview:render": "python3 scripts/templates/render_local_preview.py",
    "references:scan": "python3 scripts/references/scan_temporal.py",
    "preview:smoke": "node scripts/templates/smoke_local_preview.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
