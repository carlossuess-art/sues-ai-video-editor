{
  "version": "1.0",
  "id": "SUES_CALMA",
  "pacing": "slow",
  "cuts": {
    "minShot": 2.2,
    "maxShot": 7
  },
  "camera": {
    "baseZoom": 1.04,
    "maxZoom": 1.18,
    "zoomReasons": [
      "emphasis",
      "revelation",
      "emotional-turn"
    ]
  },
  "captions": {
    "mode": "blocks"
  },
  "transitions": {
    "allowed": [
      "cut",
      "soft-fade"
    ]
  },
  "motion": {
    "allowed": [
      "blurred-resource",
      "numbered-list",
      "quote-card"
    ]
  },
  "look": {
    "blackWhite": "optional",
    "relight": "optional"
  },
  "audio": {
    "families": [
      "calma-expansion",
      "shadow-tension"
    ]
  },
  "constraints": {
    "semanticZoomOnly": true,
    "respectSafeZones": true
  },
  "visualStyle": {
    "version": "1.0",
    "status": "provisional",
    "direction": "cinematic-nature-retreat",
    "referenceMood": "Documental cinematográfico de naturaleza y exteriores; inspiración National Geographic, sin usar identidad ni material de esa marca.",
    "sources": [
      "nature",
      "exterior",
      "retreat"
    ],
    "colorTreatment": "natural",
    "cameraMovement": "slow",
    "voice": "original",
    "captions": "discreet",
    "brandMode": "shared-kit",
    "broll": {
      "minShot": 2.5,
      "maxShot": 6,
      "maxCoverage": 0.4,
      "minPresenterGap": 3,
      "openingPresenterSeconds": 2,
      "closingPresenterSeconds": 3,
      "layout": "full-frame",
      "selection": "semantic-only",
      "allowSourceAudio": false,
      "reuseAssets": false,
      "fallback": "presenter"
    }
  }
}
