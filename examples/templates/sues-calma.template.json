{
  "version": "1.0",
  "id": "SUES_CALMA",
  "pacing": "slow",
  "cuts": {
    "minShot": 2.2,
    "maxShot": 7
  },
  "camera": {
    "baseZoom": 1.04,
    "maxZoom": 1.18,
    "zoomReasons": [
      "emphasis",
      "revelation",
      "emotional-turn"
    ]
  },
  "captions": {
    "mode": "short-groups",
    "fontSize": 96,
    "scaleX": 94,
    "tracking": -2,
    "maxWords": 3,
    "maxDuration": 2.4,
    "entranceMs": 180,
    "fadeMs": 60,
    "reference": "deckeanu-keanu-primary",
    "fontIdentity": "visual-approximation-not-identified"
  },
  "transitions": {
    "allowed": [
      "cut",
      "soft-fade"
    ]
  },
  "motion": {
    "allowed": [
      "blurred-resource",
      "numbered-list",
      "quote-card",
      "divider-line"
    ]
  },
  "look": {
    "blackWhite": "optional",
    "relight": "optional"
  },
  "audio": {
    "families": [
      "calma-expansion",
      "shadow-tension"
    ]
  },
  "constraints": {
    "semanticZoomOnly": true,
    "respectSafeZones": true
  },
  "visualStyle": {
    "version": "1.0",
    "status": "provisional",
    "direction": "cinematic-nature-retreat",
    "referenceMood": "Referencia principal: Reel de deckeanu sobre Keanu Reeves; secundaria: Sues_Reel2_May_V1. Adaptación pausada con naturaleza y retiros como recursos de apoyo cuando proceda.",
    "sources": [
      "nature",
      "exterior",
      "retreat"
    ],
    "colorTreatment": "natural",
    "cameraMovement": "slow",
    "voice": "original",
    "captions": "discreet",
    "brandMode": "shared-kit",
    "broll": {
      "minShot": 2.5,
      "maxShot": 6,
      "maxCoverage": 0.4,
      "minPresenterGap": 3,
      "openingPresenterSeconds": 2,
      "closingPresenterSeconds": 3,
      "layout": "full-frame",
      "selection": "semantic-only",
      "allowSourceAudio": false,
      "reuseAssets": false,
      "fallback": "presenter"
    },
    "resourceTreatment": {
      "type": "blurred-focus",
      "sigma": 18,
      "dim": 0.12,
      "fadeSeconds": 0.35,
      "scope": "literal-text-card-only",
      "reference": "deckeanu-keanu-primary"
    }
  },
  "referencePriority": [
    "deckeanu-keanu-primary",
    "sues-reel2-may-secondary"
  ]
}
