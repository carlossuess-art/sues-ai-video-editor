{
  "version": "1.0",
  "id": "SUES_CALMA",
  "pacing": "slow",
  "cuts": {
    "minShot": 2.2,
    "maxShot": 7
  },
  "camera": {
    "baseZoom": 1.04,
    "maxZoom": 1.18,
    "zoomReasons": [
      "emphasis",
      "revelation",
      "emotional-turn"
    ]
  },
  "captions": {
    "mode": "short-groups",
    "fontSize": 112,
    "scaleX": 100,
    "tracking": -2,
    "maxWords": 3,
    "maxDuration": 2.4,
    "entranceMs": 180,
    "fadeMs": 60,
    "reference": "deckeanu-keanu-primary",
    "fontIdentity": "user-selected-Montserrat-typographic-specification",
    "hierarchy": {
      "ratio": 1.1666666666666667,
      "selection": "editorial-phrase-rules-v1",
      "keywordWeights": {
        "mirar": 5,
        "reconocer": 10,
        "ojos": 7,
        "ver": 5,
        "correr": 6,
        "luchar": 6,
        "conseguir": 6,
        "detenerte": 8,
        "sentir": 10,
        "silencio": 10,
        "caminante": 7,
        "voz": 7,
        "temores": 8,
        "culpa": 8,
        "temblores": 8,
        "ego": 9,
        "avanzar": 10,
        "mente": 9
      },
      "exceptionalWords": [
        "reconocer",
        "sentir",
        "silencio",
        "avanzar"
      ],
      "metal": "warm-gold-banded"
    },
    "progressive": true,
    "characterEntrance": {
      "staggerMs": 24,
      "settleMs": 130
    },
    "font": "Montserrat",
    "keywordUppercase": true,
    "shadow": {
      "opacity": 0.65,
      "blurPx": 15,
      "distancePx": 5,
      "angleDeg": -45
    },
    "glow": {
      "enabled": true,
      "intensity": 0.4,
      "range": 35,
      "assBlurPx": 12
    },
    "capcutReference": {
      "normalSize": [
        11,
        12
      ],
      "keywordSize": [
        13,
        14
      ],
      "tracking": -2
    }
  },
  "transitions": {
    "allowed": [
      "cut",
      "soft-fade"
    ]
  },
  "motion": {
    "allowed": [
      "blurred-resource",
      "numbered-list",
      "quote-card",
      "divider-line",
      "check",
      "cross",
      "strike-text"
    ]
  },
  "look": {
    "blackWhite": "optional",
    "relight": "optional"
  },
  "audio": {
    "families": [
      "calma-expansion",
      "shadow-tension"
    ]
  },
  "constraints": {
    "semanticZoomOnly": true,
    "respectSafeZones": true
  },
  "visualStyle": {
    "version": "1.0",
    "status": "functional",
    "direction": "cinematic-nature-retreat",
    "referenceMood": "Referencia principal: Reel de deckeanu sobre Keanu Reeves; secundaria: Sues_Reel2_May_V1. Adaptación pausada con naturaleza y retiros como recursos de apoyo cuando proceda.",
    "sources": [
      "nature",
      "exterior",
      "retreat"
    ],
    "colorTreatment": "natural",
    "cameraMovement": "slow",
    "voice": "original",
    "captions": "discreet",
    "brandMode": "shared-kit",
    "broll": {
      "minShot": 2.5,
      "maxShot": 6,
      "maxCoverage": 0.4,
      "minPresenterGap": 3,
      "openingPresenterSeconds": 2,
      "closingPresenterSeconds": 3,
      "layout": "full-frame",
      "selection": "semantic-only",
      "allowSourceAudio": false,
      "reuseAssets": false,
      "fallback": "presenter"
    },
    "resourceTreatment": {
      "type": "blurred-focus",
      "sigma": 18,
      "dim": 0.12,
      "fadeSeconds": 0.35,
      "scope": "literal-text-card-only",
      "reference": "deckeanu-keanu-primary"
    }
  },
  "referencePriority": [
    "deckeanu-keanu-primary",
    "sues-reel2-may-secondary"
  ]
}
