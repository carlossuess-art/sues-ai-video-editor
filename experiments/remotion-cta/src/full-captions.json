[
 {
  "start": 0.3,
  "end": 1.9,
  "text": "Hay una forma de perderte"
 },
 {
  "start": 1.86,
  "end": 3.28,
  "text": "a ti mismo sin darte ni cuenta,"
 },
 {
  "start": 3.44,
  "end": 4.58,
  "text": "pero es que lo peor es que"
 },
 {
  "start": 4.54,
  "end": 6.72,
  "text": "los demás pueden aplaudirte"
 },
 {
  "start": 6.68,
  "end": 7.36,
  "text": "por eso."
 },
 {
  "start": 7.74,
  "end": 8.98,
  "text": "De pequeño aprendes a portarte"
 },
 {
  "start": 8.94,
  "end": 9.98,
  "text": "bien, a no molestar,"
 },
 {
  "start": 10.44,
  "end": 12.08,
  "text": "hacer incluso lo que se espera"
 },
 {
  "start": 12.04,
  "end": 12.36,
  "text": "de ti."
 },
 {
  "start": 12.84,
  "end": 13.54,
  "text": "Y funciona,"
 },
 {
  "start": 13.88,
  "end": 15.76,
  "text": "aceptan incluso a veces hasta"
 },
 {
  "start": 15.72,
  "end": 16.4,
  "text": "te felicitan."
 },
 {
  "start": 16.86,
  "end": 18.28,
  "text": "Hasta que un día quieres decir"
 },
 {
  "start": 18.24,
  "end": 18.58,
  "text": "que no,"
 },
 {
  "start": 19.7,
  "end": 20.54,
  "text": "y te sientes culpable."
 },
 {
  "start": 21.28,
  "end": 22.62,
  "text": "Entonces intentas cambiar,"
 },
 {
  "start": 22.88,
  "end": 23.52,
  "text": "poner límites,"
 },
 {
  "start": 24.42,
  "end": 25.98,
  "text": "ser tu mismo,"
 },
 {
  "start": 26.66,
  "end": 27.6,
  "text": "pero aparece el miedo,"
 },
 {
  "start": 28.18,
  "end": 29.26,
  "text": "y sin dejar de quererme."
 },
 {
  "start": 29.22,
  "end": 30.3,
  "text": "si"
 },
 {
  "start": 31.8,
  "end": 33.06,
  "text": "dejan de quererme cuando deje"
 },
 {
  "start": 33.02,
  "end": 34.5,
  "text": "de complacerlos y ahí está"
 },
 {
  "start": 34.46,
  "end": 35.74,
  "text": "la verdadera pregunta ¿cuántas"
 },
 {
  "start": 35.7,
  "end": 37.52,
  "text": "decisiones de"
 },
 {
  "start": 37.48,
  "end": 40.24,
  "text": "tu vida has tomado por"
 },
 {
  "start": 40.2,
  "end": 41.82,
  "text": "amor y cuántas por"
 },
 {
  "start": 41.78,
  "end": 42.64,
  "text": "miedo a perderlo?"
 },
 {
  "start": 43.32,
  "end": 45.06,
  "text": "Porque despertar no"
 },
 {
  "start": 45.02,
  "end": 46.76,
  "text": "significa convertirte en alguien"
 },
 {
  "start": 46.72,
  "end": 47.4,
  "text": "diferente,"
 },
 {
  "start": 47.8,
  "end": 50.2,
  "text": "significa empezar a reconocer"
 },
 {
  "start": 50.16,
  "end": 52.1,
  "text": "¿qué partes de ti has"
 },
 {
  "start": 52.06,
  "end": 55.16,
  "text": "ido abandonando para"
 },
 {
  "start": 55.12,
  "end": 56.88,
  "text": "poder encajar? y quizás el"
 },
 {
  "start": 56.84,
  "end": 58.7,
  "text": "primer paso para cambiar no"
 },
 {
  "start": 58.66,
  "end": 60.36,
  "text": "sea cambiar tu vida sino dejar"
 },
 {
  "start": 60.32,
  "end": 62.22,
  "text": "de traicionarte en"
 },
 {
  "start": 62.18,
  "end": 64.24,
  "text": "las pequeñas decisiones"
 },
 {
  "start": 64.2,
  "end": 64.82,
  "text": "de cada día."
 }
]
